# Without this, a working tree where anyone has run `terraform init` sends
# over a gigabyte of cached provider binaries to the Docker daemon and busts
# the layer cache on every source change.
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*

.git/
.github/
.claude/

# Automation worktrees hold whole copies of the repository, so leaving them in
# the context is the same gigabyte-scale mistake as .terraform/ above.
.worktrees/
.deep-dive/

docs/
README.md
LICENSE

coverage.out
coverage.html
*audit.log
/egressgate
/egressgate.exe
/dist/
