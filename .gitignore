# Coverage artefacts. Anchored and extension-specific on purpose: a bare
# "coverage.*" also swallows scripts/coverage.sh, which is the CI gate.
/coverage.out
/coverage.html

.terraform/
*.tfstate
*.tfstate.*

# Lock files belong to root modules. A reusable module should not ship one.
terraform/modules/*/.terraform.lock.hcl

*audit.log
*audit-*.log

# Claude Code worktrees live here; they are workspaces, not repository content.
.claude/worktrees/

# Deep-dive/autobuild run worktrees live here; workspaces, not repository content.
.worktrees/
